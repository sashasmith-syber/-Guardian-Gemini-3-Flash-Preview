{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Matches the Cloudflare Workers & Pages service name.
  "name": "guardian-gemini-3-flash-preview",
  "compatibility_date": "2026-10-30",
  // Vite build output. Workers Builds must run `npm run build` before preview/deploy.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Required by `npx wrangler preview` (Workers Builds deploy command).
  // Empty is valid when Preview needs no separate vars/bindings.
  // See https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {}
}
