# Server-only. Copy this file to .env and fill in the keys there.
# Never prefix a Gemini key with VITE_. That prefix is exposed to the browser.

# Primary key. Leave blank until you are ready to call Gemini.
GEMINI_API_KEY=

# Optional extra keys for rotation, comma-separated. Duplicates are ignored.
# The bubble skips a key after 401, 403, or 429 until the cooldown ends.
GEMINI_API_KEYS=

# failover sticks to the first healthy key. round-robin spreads calls across keys.
GEMINI_KEY_STRATEGY=failover
GEMINI_KEY_COOLDOWN_MS=60000

# Safe-bubble limits.
BUBBLE_MAX_BODY_BYTES=8000000
BUBBLE_RATE_LIMIT=30
BUBBLE_RATE_WINDOW_MS=60000

# Dev and preview bind address. Defaults to loopback.
# HOST=127.0.0.1
